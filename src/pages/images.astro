---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { seenThings } from '../lib/seen-things';

const pageTitle = 'Seeing Things';

const spotifyEmbedUrl = (url: string) => {
  const trackId = url.match(/track\/([^?]+)/)?.[1];
  return trackId ? `https://open.spotify.com/embed/track/${trackId}?utm_source=generator&theme=0` : null;
};
---

<BaseLayout pageTitle={pageTitle}>
  <section class="space-y-10">
    <header class="grid gap-6 border-b border-[color:var(--rule)] pb-8 md:grid-cols-[0.8fr_1fr] md:items-end">
      <div>
        <p class="eyebrow">Look twice</p>
        <h1 class="font-display mt-3 text-5xl font-extrabold leading-[1.05] sm:text-7xl">
          <span class="title-block title-block-nowrap">{pageTitle}</span>
        </h1>
      </div>
      <p class="max-w-[60ch] text-xl leading-8 text-[color:var(--ink-muted)]">
        Composition. An audio-visual record. A collection of things seen, heard, and felt. Have a look around.
      </p>
    </header>

    <ol class="image-ledger">
      {seenThings.map((entry, index) => {
        const embedUrl = entry.spotifyTrack ? spotifyEmbedUrl(entry.spotifyTrack.url) : null;
        return (
          <li class="image-entry">
            <figure class="image-frame">
              <Image
                class="w-full object-cover"
                src={entry.image}
                alt={entry.alt}
                loading={index === 0 ? 'eager' : 'lazy'}
              />
            </figure>
            <div class="image-entry-copy">
              <p class="eyebrow">{entry.note ?? 'seen thing'}</p>
              <h2 class="font-display text-3xl font-bold leading-tight sm:text-4xl">{entry.title}</h2>
              {(entry.location || entry.paragraphs?.length) && (
                <div class="space-y-4 text-lg leading-8 text-[color:var(--ink-muted)]">
                  {entry.location && <p class="image-location">{entry.location}</p>}
                  {entry.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
                </div>
              )}
              {entry.spotifyTrack && embedUrl && (
                <iframe
                  class="image-soundtrack"
                  src={embedUrl}
                  title={entry.spotifyTrack.title}
                  width="100%"
                  height="80"
                  allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                  loading="lazy"
                ></iframe>
              )}
            </div>
          </li>
        );
      })}
    </ol>
  </section>
</BaseLayout>
