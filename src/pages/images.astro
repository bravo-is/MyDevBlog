---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = 'Seeing Things';

const seeingThings = await Promise.all(
  (await getCollection('seeingThings'))
    .sort((a, b) => a.data.sortOrder - b.data.sortOrder)
    .map(async (entry) => ({
      ...entry,
      Content: (await render(entry)).Content,
    }))
);

const spotifyEmbedUrl = (url: string) => {
  const trackId = url.match(/track\/([^?]+)/)?.[1];
  return trackId ? `https://open.spotify.com/embed/track/${trackId}?utm_source=generator&theme=0` : null;
};
---

<BaseLayout pageTitle={pageTitle}>
  <section class="space-y-10">
    <header class="grid gap-6 border-b border-[color:var(--rule)] pb-8 md:grid-cols-[0.8fr_1fr] md:items-end">
      <div>
        <p class="eyebrow">Look twice</p>
        <h1 class="font-display mt-3 text-5xl font-extrabold leading-[1.05] sm:text-7xl">
          <span class="title-block title-block-nowrap">{pageTitle}</span>
        </h1>
      </div>
      <p class="max-w-[60ch] text-xl leading-8 text-[color:var(--ink-muted)]">
        Composition. An audio-visual record. A collection of things seen, heard, and felt. Have a look around.
      </p>
    </header>

    <ol class="image-ledger">
      {seeingThings.map((entry, index) => {
        const { Content } = entry;
        const embedUrl = entry.data.spotifyTrack ? spotifyEmbedUrl(entry.data.spotifyTrack.url) : null;
        return (
          <li class="image-entry">
            <figure class="image-frame">
              <a href={`/images/${entry.id}/`} aria-label={`Open ${entry.data.title}`}>
                <Image
                  class="w-full object-cover"
                  src={entry.data.image}
                  alt={entry.data.alt}
                  loading={index === 0 ? 'eager' : 'lazy'}
                />
              </a>
            </figure>
            <div class="image-entry-copy">
              <p class="eyebrow">{entry.data.note ?? 'Seeing thing'}</p>
              <h2 class="font-display text-3xl font-bold leading-tight sm:text-4xl">
                <a href={`/images/${entry.id}/`} class="decoration-[color:var(--rust)] underline-offset-4 hover:underline focus:underline">
                  {entry.data.title}
                </a>
              </h2>
              {(entry.data.location || Content) && (
                <div class="space-y-4 text-lg leading-8 text-[color:var(--ink-muted)]">
                  {entry.data.location && <p class="image-location">{entry.data.location}</p>}
                  <Content />
                </div>
              )}
              {entry.data.spotifyTrack && embedUrl && (
                <iframe
                  class="image-soundtrack"
                  src={embedUrl}
                  title={entry.data.spotifyTrack.title}
                  width="100%"
                  height="80"
                  allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                  loading="lazy"
                ></iframe>
              )}
            </div>
          </li>
        );
      })}
    </ol>
  </section>
</BaseLayout>
