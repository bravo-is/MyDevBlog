---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { getBookshelfData } from '../lib/hardcover';
import BookCard from '../components/BookCard.astro';

const pageTitle: string = 'Bookshelf';
Astro.response.headers.set('Cache-Control', 'public, max-age=3600, stale-while-revalidate=86400');
const bookshelf = await getBookshelfData();
if (bookshelf.error) {
  console.log(`[bookshelf] ${bookshelf.error}`);
}
const MAX_VISIBLE_READ = 6;
---

<BaseLayout pageTitle={pageTitle}>
  <section class="space-y-10">
    <header class="grid gap-6 border-b border-[color:var(--rule)] pb-8 md:grid-cols-[0.8fr_1fr] md:items-end">
      <div>
        <p class="eyebrow">Reading ledger</p>
        <h1 class="font-display mt-3 text-5xl font-extrabold leading-[1.05] sm:text-7xl">
          <span class="title-block">{pageTitle}</span>
        </h1>
      </div>
      <p class="max-w-[60ch] text-xl leading-8 text-[color:var(--ink-muted)]">
        A reading ledger of what I'm reading and what I've read, provided by <a href="https://hardcover.app/home" target="_blank" rel="noopener noreferrer" class="font-semibold underline underline-offset-4">Hardcover</a>.
      </p>
    </header>

    <div class="grid gap-12">
      <section class="space-y-5">
        <div class="editorial-rule pt-5">
          <h2 class="font-display text-3xl font-bold">Currently Reading</h2>
        </div>
        {bookshelf.currentlyReading.length === 0 ? (
          <p class="text-[color:var(--ink-muted)]">No current reads.</p>
        ) : (
          <ul class="book-ledger">
            {bookshelf.currentlyReading.map((book) => (
              <BookCard book={book} />
            ))}
          </ul>
        )}
      </section>

      <section class="space-y-5">
        <div class="editorial-rule pt-5">
          <h2 class="font-display text-3xl font-bold">Read</h2>
        </div>
        {bookshelf.read.length === 0 ? (
          <p class="text-[color:var(--ink-muted)]">No completed reads.</p>
        ) : (
          <>
            <ul class="book-ledger">
              {bookshelf.read.map((book, index) => (
                <BookCard book={book} className={index >= MAX_VISIBLE_READ ? 'hidden extra-read-book' : ''} />
              ))}
            </ul>
            {bookshelf.read.length > MAX_VISIBLE_READ && (
              <button
                type="button"
                class="tag-chip cursor-pointer"
                id="read-toggle"
              >
                show all
              </button>
            )}
          </>
        )}
      </section>
    </div>
  </section>
</BaseLayout>

<script>
  document.addEventListener("astro:page-load", () => {
    const toggleBtn = document.getElementById("read-toggle");
    if (!toggleBtn) return;
    
    let isExpanded = false;
    
    toggleBtn.addEventListener("click", () => {
      isExpanded = !isExpanded;
      const extraBooks = document.querySelectorAll(".extra-read-book");
      
      extraBooks.forEach(book => {
        book.classList.toggle("hidden", !isExpanded);
      });
      
      toggleBtn.textContent = isExpanded ? "show less" : "show all";
    });
  });
</script>
