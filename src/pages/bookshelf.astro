---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { getBookshelfData } from '../lib/hardcover';
import BookCard from '../components/BookCard.astro';

const pageTitle: string = 'Bookshelf';
Astro.response.headers.set('Cache-Control', 'public, max-age=3600, stale-while-revalidate=86400');
const bookshelf = await getBookshelfData();
if (bookshelf.error) {
  console.log(`[bookshelf] ${bookshelf.error}`);
}
const MAX_VISIBLE_READ = 6;
---

<BaseLayout pageTitle={pageTitle}>
  <section class="space-y-10">
    <header class="grid gap-6 border-b border-[color:var(--rule)] pb-8 md:grid-cols-[0.8fr_1fr] md:items-end">
      <div>
        <p class="eyebrow">Paper trail</p>
        <h1 class="font-display mt-3 text-5xl font-extrabold leading-[1.05] sm:text-7xl">
          <span class="title-block">{pageTitle}</span>
        </h1>
      </div>
      <p class="max-w-[60ch] text-xl leading-8 text-[color:var(--ink-muted)]">
        Evidence of what I'm reading and what I've read. Provided by <a href="https://hardcover.app/home" target="_blank" rel="noopener noreferrer" class="font-semibold underline underline-offset-4">Hardcover</a>.
      </p>
    </header>

    <div class="grid gap-12">
      <section class="space-y-5">
        <div class="editorial-rule pt-5">
          <h2 class="font-display text-3xl font-bold">Currently Reading</h2>
        </div>
        {bookshelf.currentlyReading.length === 0 ? (
          <p class="text-[color:var(--ink-muted)]">No current reads.</p>
        ) : (
          <ul class="book-ledger">
            {bookshelf.currentlyReading.map((book) => (
              <BookCard book={book} shelf="current" />
            ))}
          </ul>
        )}
      </section>

      <section class="space-y-5">
        <div class="editorial-rule flex flex-wrap items-end justify-between gap-4 pt-5">
          <h2 class="font-display text-3xl font-bold">Read</h2>
          {bookshelf.read.length > 1 && (
            <div class="book-sort" aria-label="Sort read books">
              <span class="book-sort__label">Sort</span>
              <div class="book-sort__group" role="group" aria-label="Sort field">
                <button type="button" class="book-sort__option is-active" data-sort-key="finished" aria-pressed="true">Finished</button>
                <button type="button" class="book-sort__option" data-sort-key="rating" aria-pressed="false">Rating</button>
                <button type="button" class="book-sort__option" data-sort-key="title" aria-pressed="false">Title</button>
              </div>
              <button type="button" class="book-sort__order" id="read-sort-order" data-sort-direction="desc" aria-label="Sort descending" title="Sort descending">
                ↓
              </button>
            </div>
          )}
        </div>
        {bookshelf.read.length === 0 ? (
          <p class="text-[color:var(--ink-muted)]">No completed reads.</p>
        ) : (
          <>
            <ul class="book-ledger" id="read-list">
              {bookshelf.read.map((book, index) => (
                <BookCard
                  book={book}
                  shelf="read"
                  className={index >= MAX_VISIBLE_READ ? 'hidden extra-read-book' : ''}
                />
              ))}
            </ul>
            {bookshelf.read.length > MAX_VISIBLE_READ && (
              <button
                type="button"
                class="tag-chip cursor-pointer"
                id="read-toggle"
              >
                show all
              </button>
            )}
          </>
        )}
      </section>
    </div>
  </section>
</BaseLayout>

<script>
  document.addEventListener("astro:page-load", () => {
    const toggleBtn = document.getElementById("read-toggle");
    const sortButtons = Array.from(document.querySelectorAll("[data-sort-key]")) as HTMLButtonElement[];
    const sortOrderButton = document.getElementById("read-sort-order") as HTMLButtonElement | null;
    const readList = document.getElementById("read-list") as HTMLUListElement | null;
    
    let isExpanded = false;
    let sortKey = "finished";
    let sortDirection: "asc" | "desc" = "desc";
    const maxVisibleRead = 6;
    const readItems: HTMLElement[] = readList ? Array.from(readList.children) as HTMLElement[] : [];

    readItems.forEach((book, index) => {
      book.setAttribute("data-original-index", String(index));
    });

    const applyVisibility = () => {
      readItems.forEach((book, index) => {
        book.classList.toggle("hidden", !isExpanded && index >= maxVisibleRead);
        book.classList.toggle("extra-read-book", index >= maxVisibleRead);
      });
    };

    const compareText = (a: HTMLElement, b: HTMLElement, key: string, direction: 1 | -1) =>
      direction * (a.getAttribute(key) ?? "").localeCompare(b.getAttribute(key) ?? "", undefined, { sensitivity: "base" });

    const compareDate = (a: HTMLElement, b: HTMLElement, direction: 1 | -1) => {
      const dateA = a.getAttribute("data-finished-at") || "";
      const dateB = b.getAttribute("data-finished-at") || "";
      if (!dateA && !dateB) return 0;
      if (!dateA) return 1;
      if (!dateB) return -1;
      return direction * dateA.localeCompare(dateB);
    };

    const compareRating = (a: HTMLElement, b: HTMLElement, direction: 1 | -1) => {
      const rawRatingA = a.getAttribute("data-rating") || "";
      const rawRatingB = b.getAttribute("data-rating") || "";
      const ratingA = Number(rawRatingA);
      const ratingB = Number(rawRatingB);
      const hasA = rawRatingA !== "" && Number.isFinite(ratingA);
      const hasB = rawRatingB !== "" && Number.isFinite(ratingB);
      if (!hasA && !hasB) return 0;
      if (!hasA) return 1;
      if (!hasB) return -1;
      return direction * (ratingA - ratingB);
    };

    const getOrderLabel = () => {
      if (sortKey === "finished") return sortDirection === "desc" ? "Sort newest first" : "Sort oldest first";
      if (sortKey === "rating") return sortDirection === "desc" ? "Sort highest first" : "Sort lowest first";
      return sortDirection === "desc" ? "Sort A to Z" : "Sort Z to A";
    };

    const syncSortControls = () => {
      sortButtons.forEach((button) => {
        const isActive = button.dataset.sortKey === sortKey;
        button.classList.toggle("is-active", isActive);
        button.setAttribute("aria-pressed", String(isActive));
      });

      if (!sortOrderButton) return;

      sortOrderButton.textContent = sortDirection === "desc" ? "↓" : "↑";
      sortOrderButton.setAttribute("aria-label", getOrderLabel());
      sortOrderButton.setAttribute("title", getOrderLabel());
      sortOrderButton.dataset.sortDirection = sortDirection;
    };

    const applySort = () => {
      if (!readList) return;

      readItems.sort((a, b) => {
        if (sortKey === "finished") return compareDate(a, b, sortDirection === "desc" ? -1 : 1);
        if (sortKey === "rating") return compareRating(a, b, sortDirection === "desc" ? -1 : 1);
        if (sortKey === "title") return compareText(a, b, "data-title", sortDirection === "desc" ? 1 : -1);

        return 0;
      });

      readItems.forEach((book) => readList.appendChild(book));
      applyVisibility();
      syncSortControls();
    };

    sortButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const nextSortKey = button.dataset.sortKey ?? "finished";
        if (sortKey !== nextSortKey) {
          sortKey = nextSortKey;
        }
        applySort();
      });
    });

    sortOrderButton?.addEventListener("click", () => {
      sortDirection = sortDirection === "desc" ? "asc" : "desc";
      applySort();
    });

    applySort();

    if (!toggleBtn) return;
    
    toggleBtn.addEventListener("click", () => {
      isExpanded = !isExpanded;
      applyVisibility();
      
      toggleBtn.textContent = isExpanded ? "show less" : "show all";
    });
  });
</script>
