---
import { Picture, getImage } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = 'Seeing Things';

const seeingThings = await Promise.all(
  (await getCollection('seeingThings'))
    .sort((a, b) => a.data.sortOrder - b.data.sortOrder)
    .map(async (entry) => {
      const lightboxImage = await getImage({
        src: entry.data.image,
        width: Math.min(entry.data.image.width, 2048),
        format: 'webp',
        quality: 90,
      });

      return {
        ...entry,
        Content: (await render(entry)).Content,
        hasBody: (entry.body ?? '').trim().length > 0,
        lightboxSrc: lightboxImage.src,
      };
    })
);

const spotifyEmbedUrl = (url: string) => {
  const trackId = url.match(/track\/([^?]+)/)?.[1];
  return trackId ? `https://open.spotify.com/embed/track/${trackId}?utm_source=generator&theme=0` : null;
};
---

<BaseLayout pageTitle={pageTitle}>
  <section class="space-y-10">
    <header class="grid gap-6 border-b border-[color:var(--rule)] pb-8 md:grid-cols-[0.8fr_1fr] md:items-end">
      <div>
        <p class="eyebrow">Look twice</p>
        <h1 class="font-display mt-3 text-5xl font-extrabold leading-[1.05] sm:text-7xl">
          <span class="title-block title-block-nowrap">{pageTitle}</span>
        </h1>
      </div>
      <p class="max-w-[60ch] text-xl leading-8 text-[color:var(--ink-muted)]">
        Composition. An audio-visual record. A collection of things seen, heard, and felt. Have a look around.
      </p>
    </header>

    <ol class="image-ledger">
      {seeingThings.map((entry, index) => {
        const { Content } = entry;
        const embedUrl = entry.data.spotifyTrack ? spotifyEmbedUrl(entry.data.spotifyTrack.url) : null;
        return (
          <li class="image-entry">
            <figure class="image-frame">
              <button
                class="image-zoom-button"
                type="button"
                aria-label={`Enlarge ${entry.data.title}`}
                data-lightbox-trigger
                data-lightbox-src={entry.lightboxSrc}
                data-lightbox-alt={entry.data.alt}
                data-lightbox-label={`${entry.data.title}${entry.data.location ? `, ${entry.data.location}` : ''}`}
              >
                <Picture
                  class="w-full object-cover"
                  src={entry.data.image}
                  alt={entry.data.alt}
                  formats={['avif', 'webp']}
                  fallbackFormat="jpg"
                  layout="constrained"
                  quality="high"
                  priority={index === 0}
                />
              </button>
            </figure>
            <div class="image-entry-copy">
              <p class="eyebrow">{entry.data.note ?? 'Seeing thing'}</p>
              <h2 class="font-display text-3xl font-bold leading-tight sm:text-4xl">
                {entry.data.title}
              </h2>
              {(entry.data.location || entry.hasBody) && (
                <div class="space-y-4 text-lg leading-8 text-[color:var(--ink-muted)]">
                  {entry.data.location && <p class="image-location">{entry.data.location}</p>}
                  {entry.hasBody && <Content />}
                </div>
              )}
              {entry.data.spotifyTrack && embedUrl && (
                <iframe
                  class="image-soundtrack"
                  src={embedUrl}
                  title={entry.data.spotifyTrack.title}
                  width="100%"
                  height="80"
                  allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                  loading="lazy"
                ></iframe>
              )}
            </div>
          </li>
        );
      })}
    </ol>

    <dialog class="image-lightbox" aria-label="Enlarged image">
      <button class="image-lightbox__close" type="button" aria-label="Close enlarged image" data-lightbox-close>
        X
      </button>
      <figure class="image-lightbox__figure">
        <img class="image-lightbox__image" src="" alt="" data-lightbox-image />
        <figcaption class="image-lightbox__caption" data-lightbox-caption></figcaption>
      </figure>
    </dialog>
  </section>

  <script>
    const initImageLightbox = () => {
      const lightbox = document.querySelector<HTMLDialogElement>('.image-lightbox');
      const lightboxImage = lightbox?.querySelector<HTMLImageElement>('[data-lightbox-image]');
      const lightboxCaption = lightbox?.querySelector<HTMLElement>('[data-lightbox-caption]');
      const closeButton = lightbox?.querySelector<HTMLButtonElement>('[data-lightbox-close]');

      if (!lightbox || !lightboxImage || !lightboxCaption || !closeButton || lightbox.dataset.bound === 'true') {
        return;
      }

      const canUseLightbox = window.matchMedia('(min-width: 768px) and (hover: hover) and (pointer: fine)');
      const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-lightbox-trigger]'));
      const syncTriggers = () => {
        triggers.forEach((trigger) => {
          trigger.disabled = !canUseLightbox.matches;
        });
      };

      syncTriggers();
      canUseLightbox.addEventListener('change', syncTriggers);
      lightbox.dataset.bound = 'true';

      const closeLightbox = () => {
        lightbox.close();
      };

      document.addEventListener('click', (event) => {
        if (!(event.target instanceof Element)) {
          return;
        }

        const trigger = event.target.closest<HTMLButtonElement>('[data-lightbox-trigger]');

        if (!trigger) {
          return;
        }

        lightboxImage.src = trigger.dataset.lightboxSrc ?? '';
        lightboxImage.alt = trigger.dataset.lightboxAlt ?? '';
        lightboxCaption.textContent = trigger.dataset.lightboxLabel ?? '';
        lightbox.showModal();
        closeButton.focus();
      });

      closeButton.addEventListener('click', closeLightbox);

      lightbox.addEventListener('click', (event) => {
        if (event.target === lightbox) {
          closeLightbox();
        }
      });

      lightbox.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          closeLightbox();
        }
      });

      lightbox.addEventListener('close', () => {
        lightboxImage.removeAttribute('src');
      });
    };

    initImageLightbox();
    document.addEventListener('astro:page-load', initImageLightbox);
  </script>
</BaseLayout>