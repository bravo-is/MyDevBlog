---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import selfImage from '../assets/homepage-portrait.jpg';
const pageTitle = "Home Page";
---

<BaseLayout pageTitle={pageTitle}>
	<section class="color-field grid min-h-[72vh] gap-10 px-5 py-8 md:grid-cols-[minmax(0,1.05fr)_minmax(18rem,0.72fr)] md:items-stretch md:px-8 md:py-12">
		<div class="flex flex-col justify-between gap-12">
			<div class="space-y-6">
				<h1 class="font-display max-w-3xl text-5xl font-extrabold leading-[0.98] tracking-normal sm:text-6xl lg:text-7xl">
					<span class="title-block">Field Notes.</span>
				</h1>
				<p class="max-w-2xl text-xl leading-8 text-[color:var(--ink)]">
					A personal issue. Meditations, observations, and the good life.
				</p>
			</div>

			<div class="border-b border-[color:var(--rule)]">
				<a href="/about" class="index-row">
					<span class="eyebrow">Know thyself</span>
					<span class="index-title font-display text-3xl font-bold">About me</span>
				</a>
				<a href="/blog" class="index-row">
					<span class="eyebrow">Ramblings</span>
					<span class="index-title font-display text-3xl font-bold">Blog posts</span>
				</a>
				<a href="/bookshelf" class="index-row">
					<span class="eyebrow">Paper trail</span>
					<span class="index-title font-display text-3xl font-bold">Bookshelf</span>
				</a>
				<a href="/images" class="index-row">
					<span class="eyebrow">Look twice</span>
					<span class="index-title font-display text-3xl font-bold">Seeing Things</span>
				</a>
			</div>
		</div>

		<aside class="border border-[color:var(--ink)] bg-[color:var(--paper-soft)] p-4">
			<Image class="aspect-[3/4] w-full object-cover object-center" src={selfImage} alt="Israel Bravo" />
			<div class="mt-4 flex items-start justify-between gap-4 border-t border-[color:var(--rule)] pt-4">
				<p class="font-display text-2xl font-bold leading-none">Israel Bravo</p>
				<p class="max-w-36 text-right text-sm italic text-[color:var(--ink-muted)]">circa 2026</p>
			</div>
		</aside>
	</section>

	<section class="grid gap-8 py-12 md:grid-cols-[0.65fr_1fr]">
		<div>
			<h2 class="font-display text-4xl font-bold">Interests and working goals.</h2>
		</div>
		<div class="grid gap-4 sm:grid-cols-2">
			<p class="border-t border-[color:var(--rule)] pt-4 text-lg leading-8">Software systems and architecture, particularly the simplification of complex problems and processes.</p>
			<p class="border-t border-[color:var(--rule)] pt-4 text-lg leading-8">Philosophy as a way of life: meditation, ethics, politics, and the good life.</p>
			<p class="border-t border-[color:var(--rule)] pt-4 text-lg leading-8">Cultural products: Movies, music, social occasions.</p>
			<p class="border-t border-[color:var(--rule)] pt-4 text-lg leading-8">Embodiment: well-being, fitness, personal style.</p>
		</div>
	</section>
</BaseLayout>
