---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import previewImage from '../assets/seen/tokyo-parallel-road.jpg';

const pageTitle = 'Palette Preview';

const palettes = [
  {
    name: 'A. Current, But Less Cream',
    mood: 'Closest to current, with a less parchment-heavy ground.',
    tokens: {
      paper: '#e4e1d7',
      paperSoft: '#f4f0e6',
      field: '#d9dcc5',
      maroon: '#6f1d1b',
      olive: '#566b3d',
      ochre: '#9b5f00',
      ink: '#2a2119',
      inkMuted: '#615d50',
    },
  },
  {
    name: 'B. Stone Editorial',
    mood: 'Warm gray, quiet, and less cream-coded.',
    tokens: {
      paper: '#d9d8d0',
      paperSoft: '#efede4',
      field: '#d0d4c4',
      maroon: '#6f1d1b',
      olive: '#4f5d45',
      ochre: '#a17316',
      ink: '#25221d',
      inkMuted: '#5f5a4f',
    },
  },
  {
    name: 'C. Charcoal Library',
    mood: 'More serious, heavier, and bookish.',
    tokens: {
      paper: '#d6d2c6',
      paperSoft: '#ece6da',
      field: '#c9c8bb',
      maroon: '#6f1d1b',
      olive: '#4d5944',
      ochre: '#8d6a18',
      ink: '#241f1c',
      inkMuted: '#5b554d',
    },
  },
  {
    name: 'D. Teal Counterpoint',
    mood: 'More distinctive, using maroon’s complementary direction.',
    tokens: {
      paper: '#d8ddd8',
      paperSoft: '#eef0e8',
      field: '#c8d3cf',
      maroon: '#6f1d1b',
      olive: '#1b6d6f',
      ochre: '#9b7a22',
      ink: '#202423',
      inkMuted: '#55615e',
    },
  },
  {
    name: 'E. Olive And Oat',
    mood: 'Classic maroon, olive, and mustard warmth.',
    tokens: {
      paper: '#ded9c9',
      paperSoft: '#f0eadc',
      field: '#d4d3bd',
      maroon: '#6f1d1b',
      olive: '#6b6b3a',
      ochre: '#c8941f',
      ink: '#2b241d',
      inkMuted: '#665d50',
    },
  },
  {
    name: 'F. Dusty Rose Editorial',
    mood: 'Softer, tonal, and more literary.',
    tokens: {
      paper: '#e1d8d5',
      paperSoft: '#f2ebe8',
      field: '#dccfcb',
      maroon: '#6f1d1b',
      olive: '#9a8772',
      ochre: '#c18c8c',
      ink: '#2a2220',
      inkMuted: '#675c58',
    },
  },
  {
    name: 'G. Navy Archive',
    mood: 'Sharper, more archival, less earthy.',
    tokens: {
      paper: '#d8d7d2',
      paperSoft: '#eeece5',
      field: '#c8ccd0',
      maroon: '#6f1d1b',
      olive: '#1f2a44',
      ochre: '#a47b20',
      ink: '#202026',
      inkMuted: '#565661',
    },
  },
];

const paletteStyle = (tokens: (typeof palettes)[number]['tokens']) => [
  `--paper: ${tokens.paper}`,
  `--paper-soft: ${tokens.paperSoft}`,
  `--field: ${tokens.field}`,
  `--maroon: ${tokens.maroon}`,
  '--title-chalk: #fbfcf4',
  `--olive: ${tokens.olive}`,
  `--ink: ${tokens.ink}`,
  `--ink-muted: ${tokens.inkMuted}`,
  '--rule: color-mix(in srgb, var(--ink) 34%, transparent)',
  '--sage: var(--olive)',
  `--ochre: ${tokens.ochre}`,
  '--accent: var(--maroon)',
  '--ink-offset: color-mix(in srgb, var(--ink) 16%, transparent)',
].join('; ');
---

<BaseLayout pageTitle={pageTitle}>
  <section class="space-y-8">
    <header class="border-b border-[color:var(--rule)] pb-8">
      <p class="eyebrow">Design study</p>
      <h1 class="font-display mt-3 text-5xl font-extrabold leading-[1.05] sm:text-7xl">
        <span class="title-block">{pageTitle}</span>
      </h1>
      <p class="mt-6 max-w-[64ch] text-xl leading-8 text-[color:var(--ink-muted)]">
        Seven palette directions around the original maroon. These are local previews only.
      </p>
    </header>

    <div class="palette-preview-list">
      {palettes.map((palette) => (
        <article class="palette-preview-row" style={paletteStyle(palette.tokens)}>
          <div class="palette-preview-sample">
            <div class="palette-preview-copy">
              <p class="eyebrow">{palette.name}</p>
              <h2 class="font-display text-4xl font-bold leading-tight">
                <span class="title-block">Seeing Things</span>
              </h2>
              <p class="text-lg leading-8 text-[color:var(--ink-muted)]">{palette.mood}</p>
              <div class="palette-preview-tags">
                <span class="tag-chip">Look twice</span>
                <span class="tag-chip">Back and forth</span>
              </div>
            </div>
            <figure class="image-frame">
              <Picture
                class="aspect-[4/3] w-full object-cover"
                src={previewImage}
                alt="Parallel roads in Tokyo with cars and buildings."
                formats={['avif', 'webp']}
                fallbackFormat="jpg"
                layout="constrained"
                width={520}
                quality="mid"
              />
            </figure>
          </div>
          <div class="palette-preview-swatches" aria-label={`${palette.name} swatches`}>
            {Object.entries(palette.tokens).map(([label, value]) => (
              <div class="palette-preview-swatch">
                <span class="palette-preview-swatch-chip" style={`background: ${value}`}></span>
                <span>{label}</span>
                <code>{value}</code>
              </div>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .palette-preview-list {
    display: grid;
    gap: 1.25rem;
  }

  .palette-preview-row {
    background: var(--paper);
    color: var(--ink);
    border: 1px solid var(--rule);
    padding: clamp(1rem, 2vw, 1.5rem);
  }

  .palette-preview-sample {
    display: grid;
    gap: 1.25rem;
  }

  .palette-preview-copy {
    display: grid;
    align-content: start;
    gap: 0.85rem;
  }

  .palette-preview-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .palette-preview-swatches {
    display: grid;
    gap: 0.45rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
  }

  .palette-preview-swatch {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.82rem;
    color: var(--ink-muted);
  }

  .palette-preview-swatch-chip {
    width: 1.5rem;
    aspect-ratio: 1;
    border: 1px solid var(--rule);
  }

  .palette-preview-swatch code {
    color: var(--ink);
  }

  @media (min-width: 760px) {
    .palette-preview-sample {
      grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.85fr);
      align-items: center;
    }

    .palette-preview-swatches {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
