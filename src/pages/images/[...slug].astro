---
import { Picture } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('seeingThings');

  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const spotifyEmbedUrl = (url: string) => {
  const trackId = url.match(/track\/([^?]+)/)?.[1];
  return trackId ? `https://open.spotify.com/embed/track/${trackId}?utm_source=generator&theme=0` : null;
};

const embedUrl = entry.data.spotifyTrack ? spotifyEmbedUrl(entry.data.spotifyTrack.url) : null;
---

<BaseLayout pageTitle={entry.data.title} pageDescription={entry.data.alt}>
  <article class="mx-auto max-w-5xl">
    <header class="mb-10 border-b border-[color:var(--rule)] pb-8">
      <p class="eyebrow">{entry.data.note ?? 'Seeing thing'}</p>
      <h1 class="font-display mt-3 text-5xl font-extrabold leading-[1.05] sm:text-7xl">
        <span class="title-block">{entry.data.title}</span>
      </h1>
      {entry.data.location && <p class="image-location mt-6 text-xl">{entry.data.location}</p>}
    </header>

    <figure class="image-frame mb-10">
      <Picture
        class="w-full object-cover"
        src={entry.data.image}
        alt={entry.data.alt}
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        layout="constrained"
        quality="high"
        priority
      />
    </figure>

    <div class="grid gap-6 md:grid-cols-[1fr_24rem] md:items-start">
      <div class="space-y-4 text-lg leading-8 text-[color:var(--ink-muted)]">
        <Content />
      </div>

      {entry.data.spotifyTrack && embedUrl && (
        <iframe
          class="image-soundtrack"
          src={embedUrl}
          title={entry.data.spotifyTrack.title}
          width="100%"
          height="80"
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          loading="lazy"
        ></iframe>
      )}
    </div>
  </article>
</BaseLayout>
