---
const { frontmatter } = Astro.props;
import BaseLayout from "./BaseLayout.astro";
import { formatPostDate, postDateTime } from "../lib/dates";

const formattedDate = formatPostDate(frontmatter.pubDate);

const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;
const featuredImage = frontmatter.image?.url ? frontmatter.image : undefined;
const fallbackImagePath = "/images/social/default-self-card-1200x630.webp";
const socialImagePath = frontmatter.image?.url ?? fallbackImagePath;
const socialImageUrl = new URL(socialImagePath, siteUrl).href;
---

<BaseLayout pageTitle={frontmatter.title}>
  <Fragment slot="head">
    <meta name="description" content={frontmatter.description} />
    <link rel="canonical" href={pageUrl} />

    <meta property="og:type" content="article" />
    <meta property="og:title" content={frontmatter.title} />
    <meta property="og:description" content={frontmatter.description} />
    <meta property="og:site_name" content="Israel Bravo" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:url" content={socialImageUrl} />
    <meta property="og:image:secure_url" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={frontmatter.image?.alt ?? "Israel Bravo's blog preview image"} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={frontmatter.title} />
    <meta name="twitter:description" content={frontmatter.description} />
    <meta name="twitter:url" content={pageUrl} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={frontmatter.image?.alt ?? "Israel Bravo's blog preview image"} />

    <meta property="article:published_time" content={frontmatter.pubDate.toISOString()} />
    {frontmatter.author && <meta property="article:author" content={frontmatter.author} />}
    {frontmatter.tags?.map((tag: string) => <meta property="article:tag" content={tag} />)}
  </Fragment>
  
  <article class="mx-auto max-w-4xl">
    <header class="mb-10 border-b border-[color:var(--rule)] pb-8">
      {frontmatter.tags && frontmatter.tags.length > 0 && (
        <div class="mb-5 flex flex-wrap gap-2">
          {frontmatter.tags.map((tag: string) => (
            <a 
              href={`/tags/${tag}`} 
              class="tag-chip"
            >
              {tag}
            </a>
          ))}
        </div>
      )}
      
      <h1 class="font-display max-w-4xl text-4xl font-extrabold leading-[1.08] tracking-normal md:text-6xl">
        <span class="title-block">{frontmatter.title}</span>
      </h1>
      
      {frontmatter.description && (
        <p class="mt-6 max-w-3xl text-2xl leading-9 text-[color:var(--ink-muted)]">
          {frontmatter.description}
        </p>
      )}
      
      <div class="mt-8 flex flex-wrap gap-3 border-t border-[color:var(--rule)] pt-4 text-sm font-bold text-[color:var(--ink-muted)]">
        <span>{frontmatter.author}</span>
        <span class="text-[color:var(--rust)]">/</span>
        <time datetime={postDateTime(frontmatter.pubDate)}>{formattedDate}</time>
      </div>
    </header>

    {featuredImage && (
      <figure class="sketch-box mb-12 p-3">
        <img 
          src={featuredImage.url}
          alt={featuredImage.alt ?? ''}
          class="w-full object-cover"
          loading="lazy"
        />
        {featuredImage.alt && (
          <figcaption class="mt-3 border-t border-[color:var(--rule)] pt-3 text-center text-sm italic text-[color:var(--ink-muted)]">
            {featuredImage.alt}
          </figcaption>
        )}
      </figure>
    )}

    <div class="prose prose-lg mx-auto max-w-[64ch]">
      <slot />
    </div>
  </article>
</BaseLayout>
