---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

const {pageTitle, customBodyStyle} = Astro.props;
const title = pageTitle === "Home Page" ? "Israel Bravo" : `${pageTitle} | Israel Bravo`;
---

<html lang="en" transition:animate="none">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Israel Bravo's personal journal on software, books, philosophy, and careful craft." />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700;9..144,800&family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap" rel="stylesheet">
		<slot name="head" />
		<title>{title}</title>
		<ClientRouter />
	</head>
	<body class:list={[customBodyStyle]}>
		<div class="site-shell">
			<Header transition:persist/>
			<main class="site-main">
				<slot />
			</main>
			<Footer transition:persist/>
		</div>
	</body>
</html>
