---
import type { BookshelfItem } from '../lib/hardcover';

type Props = {
  book: BookshelfItem;
  className?: string;
};

const { book, className = '' } = Astro.props;
---

<li class={`border-b border-[color:var(--rule)] ${className}`.trim()}>
  <a href={book.bookUrl} target="_blank" rel="noopener noreferrer" class="grid grid-cols-[4.25rem_minmax(0,1fr)] items-center gap-4 py-4 hover:bg-[color:var(--paper-soft)] sm:grid-cols-[5rem_minmax(0,1fr)_8rem] sm:px-3">
    {book.coverUrl ? (
      <img
        src={book.coverUrl}
        alt={`${book.title} cover`}
        class="aspect-[2/3] w-full border border-[color:var(--rule)] object-cover"
        loading="lazy"
      />
    ) : (
      <div class="flex aspect-[2/3] w-full items-center justify-center border border-[color:var(--rule)] bg-[color:var(--ink)] text-xs text-[color:var(--paper)]">
        No cover
      </div>
    )}
    <p class="font-display text-xl font-bold leading-8 text-[color:var(--ink)] sm:text-2xl sm:leading-9">{book.title}</p>
    <span class="hidden text-right text-sm italic text-[color:var(--ink-muted)] sm:block">Hardcover</span>
  </a>
</li>
