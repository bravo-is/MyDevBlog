---
import type { BookshelfItem } from '../lib/hardcover';

type Props = {
  book: BookshelfItem;
  className?: string;
};

const { book, className = '' } = Astro.props;
---

<li class={`group cursor-pointer ${className}`.trim()}>
  <a href={book.bookUrl} target="_blank" rel="noopener noreferrer" class="block">
    <div class="sketch-box relative overflow-hidden p-2 transition-transform duration-200 group-hover:-translate-y-1">
    {book.coverUrl ? (
      <img
        src={book.coverUrl}
        alt={`${book.title} cover`}
        class="aspect-[2/3] w-full object-cover"
        loading="lazy"
      />
    ) : (
      <div class="flex aspect-[2/3] w-full items-center justify-center bg-[color:var(--ink)] text-xs text-[color:var(--paper)]">
        No cover
      </div>
    )}
    <div class="absolute inset-x-2 bottom-2 bg-[color:var(--paper-soft)] p-3 opacity-100 transition-opacity duration-200 md:opacity-0 md:group-hover:opacity-100">
      <p class="line-clamp-2 text-xs font-bold leading-5 text-[color:var(--ink)]">{book.title}</p>
    </div>
    </div>
  </a>
</li>
