---
import Hamburger from './Hamburger.astro';
import Navigation from './Navigation.astro';
import ThemeIcon from './ThemeIcon.astro';
import ProgressBar from './ProgressBar.astro';
---

<header id="main-header" class="sticky top-0 z-50 -mx-4 border-b border-[color:var(--rule)] bg-[color:var(--paper)] px-4 sm:relative sm:mx-0 sm:border">
    <nav>
        <div class="grid grid-cols-[auto_1fr_auto] items-center gap-3 py-3">
            <Hamburger />
            <a href="/" class="font-display text-center text-2xl font-extrabold leading-none tracking-normal sm:text-4xl">
                Israel Bravo
            </a>
            <ThemeIcon />
        </div>
        <Navigation />
    </nav>
    <div class="-mx-4 sm:hidden">
        <ProgressBar />
    </div>
</header>

<script>
    document.addEventListener('astro:page-load', () => {
        const header = document.getElementById('main-header');
        if (!header || header.getAttribute('data-scroll-bound') === 'true') {
            return;
        }

        header.setAttribute('data-scroll-bound', 'true');
        const onScroll = () => {
            if (window.scrollY > 100) {
                header.classList.add('border-[color:var(--ink)]');
            } else {
                header.classList.remove('border-[color:var(--ink)]');
            }
        };

        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
    });
</script>
