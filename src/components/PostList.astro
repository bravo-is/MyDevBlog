---
import type { CollectionEntry } from "astro:content";
import { formatPostDate, postDateTime } from "../lib/dates";

interface Props {
  posts: CollectionEntry<"posts">[];
}

const { posts } = Astro.props;
---

<ul class="grid border-t border-[color:var(--rule)]">
  {posts.map((post, index) => (
    <li class="group border-b border-[color:var(--rule)]">
      <a href={`/posts/${post.id}/`} class="grid gap-5 py-6 transition-colors hover:bg-[color:var(--paper-soft)] sm:grid-cols-[5rem_minmax(0,1fr)_9rem] sm:px-4">
        <p class="font-display text-4xl font-bold leading-none text-[color:var(--rust)]">
          {String(index + 1).padStart(2, '0')}
        </p>
        <article class="space-y-3">
          <div class="flex flex-wrap gap-2">
            {post.data.tags.slice(0, 3).map((tag) => (
              <span class="text-sm font-bold text-[color:var(--sage)]">
                {tag}
              </span>
            ))}
          </div>
          <h2 class="font-display text-3xl font-bold leading-tight decoration-[color:var(--rust)] underline-offset-4 group-hover:underline sm:text-4xl">
            {post.data.title}
          </h2>
          <p class="max-w-2xl text-lg leading-8 text-[color:var(--ink-muted)]">
            {post.data.description}
          </p>
        </article>
        <time datetime={postDateTime(post.data.pubDate)} class="text-sm font-semibold text-[color:var(--ink-muted)] sm:text-right">
          {formatPostDate(post.data.pubDate)}
        </time>
      </a>
    </li>
  ))}
</ul>
