---
<button type="button" class="menu grid size-10 place-items-center border border-[color:var(--rule)] bg-[color:var(--paper-soft)] text-[color:var(--ink)] sm:hidden" aria-label="Toggle navigation">
    <svg viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="hamburger size-7">
        <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.75h-16.5M20.25 12h-16.5M12 17.25h-8.25" />
    </svg>
    <svg viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="close hidden size-7">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
    </svg>            
</button>

<script>
    document.addEventListener('astro:page-load', () => {
        const menuButton = document.querySelector('.menu');
        if (!menuButton || menuButton.getAttribute('data-bound') === 'true') {
            return;
        }

        menuButton.setAttribute('data-bound', 'true');
        menuButton.addEventListener('click', function() {
            const navLinks = document.querySelector('.nav-links');
            const hamburger = document.querySelector('.hamburger');
            const close = document.querySelector('.close');
            navLinks?.classList.toggle('hidden');
            hamburger?.classList.toggle('hidden');
            close?.classList.toggle('hidden');
        });
    });
</script>
