<button id="mobile-menu-button" type="button" class="menu grid size-10 place-items-center border border-[color:var(--rule)] bg-[color:var(--paper-soft)] text-[color:var(--ink)] sm:hidden" aria-label="Toggle navigation" aria-controls="mobile-nav" aria-expanded="false">
    <svg viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="hamburger size-7" data-menu-icon>
        <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.75h-16.5M20.25 12h-16.5M12 17.25h-8.25" />
    </svg>
    <svg viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="close hidden size-7" data-close-icon>
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
    </svg>            
</button>
